{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/syrax68/bs-road/catalog/schema/place.schema.json",
  "title": "Lieu du catalogue BS Road",
  "description": "Un marché de gros ou une boutique à visiter. Un fichier par lieu, nommé <id>.json. Textes en français, à la deuxième personne du singulier. Coordonnées en WGS-84.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "zh", "name", "city", "area", "categories", "amapQuery", "address", "access", "hours", "sells", "moq", "tips", "sources", "lat", "lng"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$", "description": "Identifiant stable, égal au nom du fichier. Ne jamais le changer : les notes de l'utilisateur y sont rattachées." },
    "zh": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Nom chinois de l'enseigne, à montrer au chauffeur." },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "alt": { "type": "string", "maxLength": 80 },
    "city": { "enum": ["gz", "other"], "description": "gz pour Guangzhou." },
    "cityName": { "type": "string", "maxLength": 40, "description": "Obligatoire si city vaut other." },
    "group": { "enum": ["sz", "near", "far"], "description": "Si city vaut other : sz (Shenzhen), near (aller-retour dans la journée), far." },
    "zone": { "type": "string", "description": "Quartier de Guangzhou (zones.json). Absent si aucun ne convient." },
    "area": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Quartier et ville, en clair." },
    "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "amapQuery": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Mots-clés chinois pour chercher le lieu dans Amap." },
    "address": { "type": "string", "minLength": 1, "maxLength": 200 },
    "addressZh": { "type": "string", "maxLength": 200 },
    "access": { "type": "string", "minLength": 1, "maxLength": 400 },
    "hours": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sells": { "type": "string", "minLength": 1, "maxLength": 800 },
    "moq": { "type": "string", "minLength": 1, "maxLength": 300 },
    "tips": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "sources": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "url": { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "lat": { "type": "number", "minimum": 16, "maximum": 54 },
    "lng": { "type": "number", "minimum": 73, "maximum": 135 },
    "approx": { "type": "string", "maxLength": 200, "description": "Présent si la position est approximative : dit sur quoi le repère est posé." },
    "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date d'ajout, pour le badge Nouveau." },
    "transit": {
      "type": "object",
      "description": "Arrêts les plus proches, calculés par tools/transit.py depuis OpenStreetMap. Ne pas éditer à la main.",
      "additionalProperties": false,
      "required": ["metro", "bus"],
      "properties": {
        "metro": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["zh", "en", "distanceM", "lines"],
              "properties": {
                "zh": { "type": "string" },
                "en": { "type": "string" },
                "exit": { "type": ["string", "null"] },
                "distanceM": { "type": "integer", "minimum": 0 },
                "lines": { "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        },
        "bus": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zh", "en", "distanceM", "lines"],
            "properties": {
              "zh": { "type": "string" },
              "en": { "type": "string" },
              "distanceM": { "type": "integer", "minimum": 0 },
              "lines": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "city": { "const": "other" } } }, "then": { "required": ["cityName", "group"] } }
  ]
}
